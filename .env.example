# Endpoint do seu LLM local, no formato OpenAI-compatible.
#   llama.cpp (llama-server): http://127.0.0.1:8080/v1
#   Ollama:                   http://127.0.0.1:11434/v1
#   LM Studio:                http://127.0.0.1:1234/v1
QWEN_ENDPOINT=http://127.0.0.1:8080/v1

# Nome do modelo carregado. O llama.cpp e o LM Studio aceitam qualquer nome
# quando ha um unico modelo; o Ollama exige o nome exato (ex.: qwen3:8b).
QWEN_MODEL=local-model
QWEN_TIMEOUT_SEGUNDOS=180

# Opcional. Sem chave a NCBI permite 3 requisicoes/segundo; com chave, 10.
# https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
PUBMED_API_KEY=

DUCKDB_PATH=./data/papers.duckdb
TOPICOS_PATH=./config/topicos.yaml

# O sync nao roda dentro do servidor MCP: agende 'papers-cli sync' com o timer
# systemd de deploy/ (veja o README).

LOG_LEVEL=INFO

# --- Modo connector (servidor HTTP). Deixe em stdio para uso local. ---
# Em streamable-http o servidor só lê a base e não chama o LLM: resumir_paper
# devolve apenas o resumo que já estiver em cache.
TRANSPORTE=stdio
HTTP_HOST=127.0.0.1
HTTP_PORTA=8000
HTTP_PATH=/mcp
HTTP_STATELESS=true
# O teto global é o que protege a máquina: o tráfego do Claude chega dos IPs da
# Anthropic, então limitar só por IP juntaria todos os usuários num balde só.
HTTP_LIMITE_GLOBAL_POR_MINUTO=1200
HTTP_LIMITE_POR_MINUTO=600

# Nomes públicos pelos quais o servidor aceita ser chamado, separados por
# vírgula. Vazio = só loopback. Atrás de um proxy ou túnel o cabeçalho Host que
# chega é o nome público, e sem ele aqui o SDK responde 421 (Invalid Host) a
# toda requisição de fora, por proteção contra DNS rebinding.
HTTP_HOSTS_PUBLICOS=
